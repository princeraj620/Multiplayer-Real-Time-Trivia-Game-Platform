# Copy to .env and change what you like. Every value here is also the default.

# Ports on your machine
HTTP_PORT=8080
HTTPS_PORT=8443

# Passwords (change them for anything that is not a laptop demo)
POSTGRES_PASSWORD=buzzarena
REPLICATION_PASSWORD=replicator
REDIS_PASSWORD=buzzarena
GRAFANA_ADMIN_PASSWORD=buzzarena

# Encryption at rest for the correct answers and the JWT signing keys: "kid:base64-32-byte-key".
# Demo key — shared by everyone who clones this repo. Generate your own for
# anything beyond a local demo: openssl rand -base64 32
# To rotate: add a new key (DATA_KEYS=k1:...,k2:...), set DATA_KEY_ACTIVE=k2, restart, then
# run `npm run rotate:data-key` to re-encrypt old rows. Generate a key: openssl rand -base64 32
DATA_KEYS=k1:0Ghvzq4sVdEkVSe0lX1U2F1cmWgC4Xl9d0ZyH2uX9R4=
DATA_KEY_ACTIVE=k1

# Access tokens live 15 minutes; refresh tokens rotate on every use.
ACCESS_TOKEN_TTL_SEC=900

# The game
QUESTION_SEC=10          # default seconds per question (hosts can choose 5-60)
COUNTDOWN_SEC=5
REVEAL_SEC=4
LEADERBOARD_SEC=4
ANSWER_GRACE_MS=300      # answers that reach a gateway up to 300 ms after the deadline still count

# Leader election: an engine that stops renewing its etcd lease loses its games after this many seconds.
LEADER_LEASE_TTL_SEC=5
# An engine stops acting as soon as it cannot prove its lease is alive. Set false to see the fencing
# token (the second line of defence) reject a stale leader instead (npm run demo:zombie).
SELF_FENCING=true

# Per-IP limits at Nginx
API_RATE_PER_IP=50
API_BURST_PER_IP=100
AUTH_RATE_PER_IP=5
AUTH_BURST_PER_IP=20
WS_CONN_PER_IP=20

# Sign-in limits per email (token bucket)
LOGIN_RATE_BURST=10
LOGIN_RATE_PER_SEC=0.2

# Tracing: share of new traces to record (1 = all, 0.02 = 2%)
TRACE_SAMPLE_RATIO=1

# Load tests only: lets the bot swarm create accounts without password hashing. Keep false in real use.
LOADTEST_MODE=false
LOADTEST_SECRET=
