# Settings for load tests and demos from ONE computer (one IP address, thousands of bots).
# docker compose --env-file .env.loadtest up -d
# Only the per-IP limits are relaxed, bot accounts are allowed, and fewer traces are recorded.
LOADTEST_MODE=true
LOADTEST_SECRET=change-me-loadtest-secret
API_RATE_PER_IP=5000
API_BURST_PER_IP=20000
AUTH_RATE_PER_IP=5000
AUTH_BURST_PER_IP=20000
WS_CONN_PER_IP=60000
LOGIN_RATE_BURST=1000
LOGIN_RATE_PER_SEC=100
TRACE_SAMPLE_RATIO=0.02
